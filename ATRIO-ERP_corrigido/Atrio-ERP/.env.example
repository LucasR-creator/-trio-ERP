# Desenvolvimento (opcional). Sem DATABASE_URL, usa SQLite em data/atrio.db.
# Para produção: PostgreSQL + HTTPS + sessões seguras, SMTP e configurações adicionais.
DATABASE_URL=postgresql+psycopg://atrio:troque_senha@localhost:5432/atrio
APP_ENV=development
# Opcional para notificações do formulário (a aplicação salva o contato mesmo sem SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=
